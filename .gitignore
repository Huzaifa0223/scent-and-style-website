# Environment / secrets
.env
*.env
!.env.example

# Python
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
.eggs/
.mypy_cache/
.ruff_cache/
.pytest_cache/
.coverage
.coverage.*
htmlcov/
coverage.xml

# Virtual environments
.venv/
venv/
env/

# Django
*.log
media/
staticfiles/
db.sqlite3

# Tooling downloads (fetched by setup_dev, not checked in). The directory is
# ignored because the Tailwind standalone binary lands here; first-party
# scripts that happen to live alongside it are source and are tracked.
# "tools/" would exclude the directory itself, and git cannot re-include a
# file whose parent directory is excluded - so the contents are ignored
# instead, which leaves the negation below able to take effect.
tools/*
!tools/*.py


# Tailwind build output — generated from static/css/input.css by setup_dev /
# the deploy pipeline, not committed (input.css, the source, is tracked)
static/css/app.css

# Editors / OS
.vscode/
.idea/
.DS_Store
Thumbs.db

# Design tool export (reference only — tokens/specs are implemented into
# tailwind.config.js/templates directly; the export itself isn't source)
/website design/

# Backups / dumps
*.sql
*.dump
backups/

# Static storefront snapshot for design review (tools/snapshot_storefront.py).
# Generated artefact, never a source of truth.
/build/
