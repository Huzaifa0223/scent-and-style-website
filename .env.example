# Copy to .env and fill in. setup_dev.ps1/.sh does this automatically on
# first run. Real secrets never get committed — .env is gitignored.

DJANGO_SETTINGS_MODULE=config.settings.dev

# Generate with: python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
SECRET_KEY=change-me-insecure-dev-key

DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

# postgres://USER:PASSWORD@HOST:PORT/NAME
DATABASE_URL=postgres://postgres:postgres@localhost:5432/ecommerce

# Seeded by setup_dev.ps1/.sh on first run (idempotent — skipped if a
# superuser already exists).
DJANGO_SUPERUSER_USERNAME=admin
DJANGO_SUPERUSER_EMAIL=admin@example.com
DJANGO_SUPERUSER_PASSWORD=change-me-insecure

# Cloudflare R2 (S3-compatible) — production media storage only. Not used
# by config.settings.dev; required by config.settings.prod (Stage 13).
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_STORAGE_BUCKET_NAME=
AWS_S3_ENDPOINT_URL=
AWS_S3_REGION_NAME=auto

# core/backup.py's media mirror (Stage 13) — optional. Leave blank to
# mirror under a prefix in the same bucket above; set to a second
# bucket name for real off-box protection against a bug that corrupts
# the live bucket. See core/backup.py's module docstring.
AWS_BACKUP_BUCKET_NAME=
# Managed-platform deployments only (docs/deploy-paas.md). Leave unset for the
# VPS deployment in docs/deploy.md, where Caddy serves STATIC_ROOT off disk.
SERVE_STATIC_FROM_R2=

# core/backup.py (Stage 13). Local dump directory and the pg_dump binary
# path — only needed to override on a host where pg_dump isn't already
# on PATH (true of this project's own Windows dev setup; not expected to
# be true on the production host once postgresql-client is installed,
# see docs/deploy.md).
BACKUP_DIR=
BACKUP_PG_DUMP_PATH=

# core.ratelimit rate limiting (Stage 13) — least-privilege runtime DB
# role. Only used by deploy/create_app_role.sql (run manually, once, by
# a human — see that file and docs/deploy.md), never read by Django
# itself.
ECOMMERCE_APP_DB_PASSWORD=

# Noor integration (noor/). Shared secret for the in-store tablets'
# /api/kiosk/sync/ API — at least 32 characters. Generate with:
#   python -c "import secrets; print(secrets.token_urlsafe(40))"
# Leave blank here; set the real value only in the server's .env. While it
# is blank/short every private sync request is answered 401.
SCENT_SYNC_TOKEN=
# POS <-> website stock sync (possync/). Shared secret for the store POS's
# /api/pos/sync/ API — at least 32 characters and DIFFERENT from
# SCENT_SYNC_TOKEN. Same generator as above. Leave blank here; set the real
# value only in the server's .env. While blank/short every POS request is 401.
SCENT_POS_TOKEN=
# false (default) = read-only: POS on-hand is used as is and web orders are NOT
# subtracted — right while staff ring web orders up at the till, so the POS
# on-hand already drops. true = also subtract web orders the POS has not
# acknowledged (only if web orders are recorded in the POS and acknowledged).
POS_SYNC_SUBTRACT_WEB_ORDERS=false
# Browser origin allowed to read the public feeds (default shown).
# NOOR_ORIGIN=https://scentiq.scentandstyle.pk
# Show the "Ask ScentIQ" and "Find similar with ScentIQ" buttons on the website.
# Leave false until https://scentiq.scentandstyle.pk is live; the API endpoints
# work either way.
NOOR_PUBLIC_LINKS=false

# §41 error monitoring hook (Stage 13) — Django's built-in mail_admins,
# no new dependency. Blank ADMINS means no emails are ever sent (not an
# error). Format: "Name:email,Name:email". Real SMTP credentials are a
# human task — see docs/deploy.md.
ADMINS=
SERVER_EMAIL=root@localhost
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=localhost
EMAIL_PORT=25
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=True
